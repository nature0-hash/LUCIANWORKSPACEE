# ─────────────────────────────────────────────────────────────────────────────
# LUCIAN Vault — Environment variables actually referenced by the code.
#
# This file lists ONLY the variables that are read by the project source.
# Add ONLY the variables you actually use. Stubs will report
# "setup_required" until their SDK is installed and a real connection is
# made — adding API keys alone does NOT enable a stub provider.
#
# DO NOT put secrets in NEXT_PUBLIC_* variables — those are exposed to
# the browser.
# ─────────────────────────────────────────────────────────────────────────────


# ════════════════════════════════════════════════════════════════════════════
# DATABASE / CORE
# ════════════════════════════════════════════════════════════════════════════

# Postgres connection string. REQUIRED for any provider-backed Vault operation.
# Neon / Supabase / Vercel Postgres / any Postgres-compatible database works.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Get from: your Postgres provider's dashboard.
# Public/Secret: SECRET — never expose.
# Vercel env: set on Production + Preview + Development.
# Currently used by: src/lib/db.ts, src/lib/vault/ledger-db.ts (via Prisma).
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ════════════════════════════════════════════════════════════════════════════
# PERSISTENCE + CRYPTO TRADING (implemented)
# ════════════════════════════════════════════════════════════════════════════

# sandbox (default): persistent LUCIAN test funds and paper orders.
# live: Coinbase-backed balances/orders; also requires LIVE_TRADING_ENABLED.
TRADING_MODE="sandbox"
NEXT_PUBLIC_TRADING_MODE="sandbox"
NEXT_PUBLIC_TRADING_CLOUD_SYNC_ENABLED="true"
NEXT_PUBLIC_WORKSPACE_CLOUD_SYNC_ENABLED="true"

# Authentication route. "api-key" is the simple owner-account route and does
# not require an OAuth Client ID. "oauth" connects a Coinbase account per user.
COINBASE_AUTH_MODE="api-key"

# Owner-account CDP key (create an ECDSA/ES256 key with
# View + Trade + Transfer + Receive). Transfer permission is powerful;
# LUCIAN still keeps sends locked behind COINBASE_TRANSFERS_ENABLED,
# password re-verification, exact confirmation, and a server USD cap.
# Preserve the private key newlines; Vercel accepts the full multiline value.
COINBASE_API_KEY_NAME="organizations/ORG_ID/apiKeys/KEY_ID"
COINBASE_API_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
COINBASE_API_KEY_ALGORITHM="ES256"

# AES-256-GCM key used to encrypt OAuth tokens in Postgres (OAuth mode only).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_ENCRYPTION_KEY=""

# Coinbase consumer-account OAuth. The redirect must exactly match the OAuth
# client configuration, e.g. https://YOUR_DOMAIN/api/integrations/coinbase/callback
COINBASE_CLIENT_ID=""
COINBASE_CLIENT_SECRET=""
COINBASE_REDIRECT_URI=""
COINBASE_OAUTH_SCOPES="wallet:user:read,wallet:accounts:read,wallet:trades:read,wallet:trades:create,offline_access"

# Optional endpoint overrides; normally leave these defaults unchanged.
COINBASE_AUTHORIZE_URL="https://login.coinbase.com/oauth2/auth"
COINBASE_TOKEN_URL="https://login.coinbase.com/oauth2/token"
COINBASE_API_BASE_URL="https://api.coinbase.com"

# Live-money kill switches. Keep false until OAuth, KYC, legal/compliance,
# preview/confirmation UI, and a small-value end-to-end test are complete.
LIVE_TRADING_ENABLED="false"
AI_TRADING_ENABLED="false"
MAX_LIVE_ORDER_USD="50"
ENABLE_SANDBOX_FUNDING="false"

# Coinbase onchain send controls. Receiving does not require the send switch.
# Keep the switch false until account/balance and receive-address tests pass.
COINBASE_TRANSFERS_ENABLED="false"
COINBASE_MAX_SEND_USD="50"
COINBASE_SEND_ALLOWED_ASSETS="BTC,ETH,USDC,SOL"
COINBASE_SEND_ALLOWED_NETWORKS="bitcoin,ethereum,base,solana"

# Cloud project upload limits (bytes). Defaults shown.
WORKSPACE_MAX_PROJECT_BYTES="26214400"
WORKSPACE_MAX_FILE_BYTES="5242880"


# ════════════════════════════════════════════════════════════════════════════
# STRIPE (Card payments) — STUB. API keys alone will NOT enable this provider.
# You must also: npm install stripe, then wire up the SDK calls in
# src/lib/vault/providers/stripe.ts (search for "PRODUCTION" comments).
# ════════════════════════════════════════════════════════════════════════════

# Stripe secret key. Server-only.
# Get from: https://dashboard.stripe.com/apikeys
# Public/Secret: SECRET.
STRIPE_SECRET_KEY="sk_test_xxx"

# Stripe webhook signing secret. Used to verify webhook signatures.
# Get from: https://dashboard.stripe.com/webhooks (click your endpoint).
# Public/Secret: SECRET.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Stripe publishable key. This is the ONLY Stripe key that's safe to
# expose to the browser (it can only create tokens, not charge cards).
# Public/Secret: PUBLIC.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"


# ════════════════════════════════════════════════════════════════════════════
# BANK PROVIDER (Plaid) — STUB. API keys alone will NOT enable this provider.
# You must also: npm install plaid, then wire up the SDK calls in
# src/lib/vault/providers/plaid.ts.
# ════════════════════════════════════════════════════════════════════════════

# Plaid client ID. Get from: https://dashboard.plaid.com/team/api_keys
# Public/Secret: SECRET.
BANK_PROVIDER_CLIENT_ID="xxx"

# Plaid secret. Same source as above.
# Public/Secret: SECRET.
BANK_PROVIDER_SECRET="xxx"

# Plaid environment: "sandbox" | "development" | "production".
# Public/Secret: PUBLIC (not sensitive — but server-only is fine).
BANK_PROVIDER_ENV="sandbox"


# ════════════════════════════════════════════════════════════════════════════
# CRYPTO PROVIDER (Coinbase Commerce / Custody) — STUB. API keys alone will
# NOT enable this provider. You must also implement the REST calls in
# src/lib/vault/providers/coinbase.ts (flip COINBASE_REST_WIRED to true
# once done).
# ════════════════════════════════════════════════════════════════════════════

# Coinbase Commerce / Custody API key. Server-only.
# Get from: your Coinbase Commerce / Custody dashboard.
# Public/Secret: SECRET.
CRYPTO_PROVIDER_API_KEY="xxx"

# Coinbase Commerce / Custody API secret. Same source as above.
# Public/Secret: SECRET.
CRYPTO_PROVIDER_API_SECRET="xxx"

# Coinbase webhook signing secret (used for HMAC verification).
# Public/Secret: SECRET.
CRYPTO_PROVIDER_WEBHOOK_SECRET="xxx"


# ════════════════════════════════════════════════════════════════════════════
# BROKER (Alpaca) — STUB. API keys alone will NOT enable this provider.
# You must also: npm install @alpacahq/alpaca-trade-api, then wire up
# the SDK calls in src/lib/vault/providers/alpaca.ts.
# ════════════════════════════════════════════════════════════════════════════

# Alpaca API key. Get from: https://app.alpaca.markets/paper/dashboard/overview
# Public/Secret: SECRET.
BROKER_API_KEY="xxx"

# Alpaca API secret. Same source as above.
# Public/Secret: SECRET.
BROKER_API_SECRET="xxx"

# Alpaca base URL. Default is paper trading.
# Public/Secret: PUBLIC.
BROKER_API_BASE_URL="https://paper-api.alpaca.markets"

# Alpaca webhook signing secret (used for HMAC verification, if your
# Alpaca plan supports webhooks).
# Public/Secret: SECRET.
BROKER_WEBHOOK_SECRET="xxx"


# ════════════════════════════════════════════════════════════════════════════
# AI MODEL PROVIDERS (shared /api/ai/chat + Economic Agent + Lilith)
# ════════════════════════════════════════════════════════════════════════════
# These variables are actually referenced by src/lib/agent/providers.ts.
# At least ONE provider's API key must be set for AI chat features to
# work. Setting multiple keys lets the user switch providers in
# Settings → Shared AI Config.
#
# All keys are SECRET — never expose in NEXT_PUBLIC_*.
# On Vercel: set each key you want to enable on Production + Preview.

# Google Gemini API key (Gemini chat completions).
# Get from: https://aistudio.google.com/app/apikey
# Public/Secret: SECRET.
GEMINI_API_KEY=""

# OpenAI API key (chat completions).
# Get from: https://platform.openai.com/api-keys
# Public/Secret: SECRET.
OPENAI_API_KEY=""

# Anthropic API key (Claude chat completions).
# Get from: https://console.anthropic.com/settings/keys
# Public/Secret: SECRET.
ANTHROPIC_API_KEY=""

# OpenRouter API key (multi-provider gateway).
# Get from: https://openrouter.ai/keys
# Public/Secret: SECRET.
OPENROUTER_API_KEY=""

# DeepSeek API key.
# Get from: https://platform.deepseek.com/api_keys
# Public/Secret: SECRET.
DEEPSEEK_API_KEY=""

# Custom OpenAI-compatible provider (any endpoint that implements the
# OpenAI /v1/chat/completions contract — e.g. Ollama, vLLM, LM Studio,
# LocalAI, OpenAI-compatible proxies).
# Base URL of the custom endpoint (no trailing slash).
# Default if unset: http://localhost:11434/v1 (Ollama).
# Public/Secret: the URL itself is not secret, but is grouped with the key.
CUSTOM_AI_BASE_URL=""
# API key for the custom endpoint (empty string for local/Ollama).
# Public/Secret: SECRET if the endpoint requires authentication.
CUSTOM_AI_API_KEY=""


# ════════════════════════════════════════════════════════════════════════════
# OPTIONAL — reserved for future phases (NOT yet referenced in code).
# Listed here so you can plan ahead. Adding these does NOT activate any
# feature — the code does not currently read them.
# ════════════════════════════════════════════════════════════════════════════

# Encryption key for provider access tokens stored in ProviderConnection
# (accessTokenEnc, refreshTokenEnc). Not yet used — the schema reserves the
# columns. Will be wired up in Phase 16 (Auth).
# Get from: openssl rand -base64 32
# Public/Secret: SECRET.
# VAULT_ENCRYPTION_KEY="base64-encoded-key"

# NOTE: NEXT_PUBLIC_APP_URL is NOT referenced by the code and is therefore
# NOT required. Do not add it unless you wire it up yourself.

# ════════════════════════════════════════════════════════════════════════════
# PHASE 16 — AUTHENTICATION
# ════════════════════════════════════════════════════════════════════════════
# These variables are actually referenced by Phase 16 source code:
#   - src/lib/auth/auth.ts
#   - app/api/auth/*
#   - middleware.ts

# ─── REQUIRED FOR AUTH ───────────────────────────────────────────────────────

# The secret used by Auth.js v5 to sign session cookies and CSRF tokens.
# Without this, Auth.js refuses to start and every sign-in fails.
# Generate with: openssl rand -base64 32
# Public/Secret: SECRET — never expose to the browser.
# Vercel env: set on Production + Preview + Development.
# Currently used by: src/lib/auth/auth.ts (NextAuth `secret` option)
# Mandatory: YES — auth does not work without it.
AUTH_SECRET=""

# The Postgres connection string for the auth database. The same database
# holds users, sessions, accounts, profile, chats, notifications, agent
# memory, saved items, AND the Vault ledger. Must be Postgres (Neon /
# Supabase / Vercel Postgres / any Postgres-compatible DB). NEVER SQLite.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Public/Secret: SECRET — never expose to the browser.
# Vercel env: set on Production + Preview + Development.
# Currently used by: src/lib/db.ts, src/lib/auth/auth.ts (Prisma adapter)
# Mandatory: YES — signup/login/session/ownership all depend on it.
# (Note: DATABASE_URL is already declared above for the Vault. Phase 16
# reuses the same variable — there is exactly one DATABASE_URL.)
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ─── GOOGLE LOGIN (OPTIONAL) ────────────────────────────────────────────────

# Google OAuth client ID. Get from: Google Cloud Console → APIs & Services →
# Credentials → Create OAuth 2.0 Client ID (Web application type).
# Add your production + preview URLs to Authorized JavaScript origins and
# Authorized redirect URIs (https://YOUR_DOMAIN/api/auth/callback/google).
# Public/Secret: PUBLIC (this is the client ID, not the secret — but
#   still kept server-side because it's only used by the OAuth flow).
# Vercel env: set on Production + Preview + Development if you want Google.
# Currently used by: src/lib/auth/auth.ts (Google provider)
# Mandatory: NO — when absent, the Google button is disabled with setup
#   guidance and Google callbacks return 503. NEVER fake Google auth.
GOOGLE_CLIENT_ID=""

# Google OAuth client secret. Same source as GOOGLE_CLIENT_ID.
# Public/Secret: SECRET — never expose to the browser, never in NEXT_PUBLIC_*.
# Vercel env: set on Production + Preview + Development if you want Google.
# Currently used by: src/lib/auth/auth.ts (Google provider)
# Mandatory: NO (paired with GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_SECRET=""

# ─── PASSWORD RESET / EMAIL DELIVERY (OPTIONAL) ────────────────────────────

# SMTP server hostname for sending password-reset emails. Get from your
# transactional email provider (Resend, Postmark, SendGrid, Amazon SES,
# Mailgun, etc.) — use the SMTP hostname they document.
# Public/Secret: SECRET (server-only).
# Vercel env: set on Production + Preview + Development if you want
# password-reset emails to actually be delivered.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO — when absent, the reset endpoint honestly reports
#   "Email delivery is not configured" and does NOT pretend to send.
SMTP_HOST=""

# SMTP username. Same source as SMTP_HOST.
# Public/Secret: SECRET.
# Vercel env: same as SMTP_HOST.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO (paired with SMTP_HOST + SMTP_PASS).
SMTP_USER=""

# SMTP password / API key. Same source as SMTP_HOST.
# Public/Secret: SECRET.
# Vercel env: same as SMTP_HOST.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO (paired with SMTP_HOST + SMTP_USER).
SMTP_PASS=""

# SMTP port. Default 587 (STARTTLS). Common alternatives: 25 (plain),
# 465 (SSL), 2525 (some providers).
# Public/Secret: PUBLIC (not sensitive).
# Vercel env: same as SMTP_HOST.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO. Defaults to 587 if not set.
SMTP_PORT="587"

# Whether to use SSL for SMTP. "true" for port 465, "false" for 587.
# Public/Secret: PUBLIC (not sensitive).
# Vercel env: same as SMTP_HOST.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO. Defaults to false (STARTTLS on port 587 is standard).
SMTP_SECURE="false"

# From: address for outgoing LUCIAN emails (password reset). Use a
# domain you've verified with your email provider. Default if unset:
# "LUCIAN <no-reply@lucian.local>" (will likely fail to deliver — set
# this to a real verified address).
# Public/Secret: PUBLIC (it's an email address, not a secret).
# Vercel env: same as SMTP_HOST.
# Currently used by: app/api/auth/reset-password/request/route.ts
# Mandatory: NO.
SMTP_FROM="LUCIAN <no-reply@example.com>"

# ─── AUTH APP URL (OPTIONAL but recommended for Vercel) ─────────────────────

# The canonical public URL of your LUCIAN deployment, WITHOUT trailing slash.
# Used to build absolute URLs (e.g. the password-reset link in the email).
# On Vercel, you can leave this unset — Auth.js detects the deployment URL
# from request headers automatically.
# Public/Secret: PUBLIC.
# Vercel env: optional. Set if you want to override auto-detection.
# Currently used by: app/api/auth/reset-password/request/route.ts (for the
# reset link URL only).
# Mandatory: NO.
AUTH_APP_URL=""

# ─── OWNER ACCOUNT BOOTSTRAP (REQUIRED ONCE) ──────────────────────────────
#
# These variables are read by `npm run bootstrap:owner`
# (scripts/bootstrap-owner.ts). The script creates the LUCIAN owner
# account (a normal user with a known username) so you can sign in
# with username LUCIAN1975 instead of email. Run the script ONCE
# after your first `npx prisma migrate deploy`. Subsequent runs are
# safe no-ops (the existing owner's password is NEVER overwritten).
#
# Usage:
#   LUCIAN_OWNER_USERNAME=LUCIAN1975 \
#   LUCIAN_OWNER_PASSWORD=<your secret> \
#   LUCIAN_OWNER_EMAIL=owner@your-domain.com \
#   npm run bootstrap:owner
#
# CRITICAL SECURITY RULES (enforced by the script):
#   - LUCIAN_OWNER_PASSWORD is NEVER logged to stdout/stderr.
#   - LUCIAN_OWNER_PASSWORD is NEVER written to a file.
#   - LUCIAN_OWNER_PASSWORD is NEVER included in API responses / error messages.
#   - LUCIAN_OWNER_PASSWORD is NEVER exposed to the client bundle.
#   - Do NOT use NEXT_PUBLIC_LUCIAN_OWNER_PASSWORD — that would expose
#     the password to the browser.
#   - Do NOT commit the actual password value to Git. Set it in your
#     shell environment, in Vercel's project settings, or in your
#     local .env.local file (which is gitignored).

# The owner username. Default if unset: LUCIAN1975 (set in your environment
# to override). The username is normalized to lowercase before storing,
# so "LUCIAN1975" becomes "lucian1975" in the DB — both forms work for
# login (the credentials provider normalizes input).
# Public/Secret: PUBLIC (the username is not secret — only the password is).
# Vercel env: NOT a Vercel env var (bootstrap runs locally, not on Vercel).
# Currently used by: scripts/bootstrap-owner.ts
# Mandatory: YES for `npm run bootstrap:owner` to run.
LUCIAN_OWNER_USERNAME="LUCIAN1975"

# The owner password. NEVER commit this value to Git — set it in your
# shell environment when running `npm run bootstrap:owner`. Use a strong
# password (12+ chars, with letters and digits — the same rules as
# regular signup).
# Public/Secret: SECRET. Never expose, never log, never put in NEXT_PUBLIC_*.
# Vercel env: NOT a Vercel env var (bootstrap runs locally).
# Currently used by: scripts/bootstrap-owner.ts
# Mandatory: YES for `npm run bootstrap:owner` to run.
LUCIAN_OWNER_PASSWORD=""

# The owner's email address. Used for password-reset recovery. Default
# if unset: owner@lucian.local (will not deliver — set to a real
# address you control).
# Public/Secret: PUBLIC (an email address, not a secret).
# Vercel env: REQUIRED in Coinbase API-key mode so server requests are
# restricted to this exact authenticated LUCIAN owner. It is also used by
# scripts/bootstrap-owner.ts when creating the owner account.
# Mandatory: YES for Coinbase API-key mode; otherwise the provider refuses.
LUCIAN_OWNER_EMAIL="owner@lucian.local"
